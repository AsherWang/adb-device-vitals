<ui:FluentWindow x:Class="AdbDeviceVitals.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="设置" Width="880" Height="640"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        FontFamily="Segoe UI" FontSize="13"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="设置" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航用自定义单选按钮实现：WPF-UI 的 NavigationView 会自带内容区，
                 放在窄列里会把菜单文字裁掉，这里只需要一个 Win11 设置样式的左栏。 -->
            <Border Grid.Column="0" Padding="8,14,8,12">
                <Border.Resources>
                    <Style x:Key="SettingsNavItem" TargetType="RadioButton">
                        <Setter Property="Foreground" Value="#FF1B1B1B" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="Padding" Value="16,9" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Root" Background="Transparent" CornerRadius="5"
                                            Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <Rectangle x:Name="Indicator" Width="3" Height="16" RadiusX="1.5"
                                                       HorizontalAlignment="Left" Margin="-12,0,0,0"
                                                       Fill="#FF0067C0" Visibility="Collapsed" />
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#FFFFFFFF" />
                                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#14000000" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>
                <StackPanel x:Name="Nav">
                    <RadioButton Content="常规" Tag="0" GroupName="SettingsNav" IsChecked="True"
                                 Style="{StaticResource SettingsNavItem}" Click="NavItem_Click" />
                    <RadioButton Content="ADB 与设备" Tag="1" GroupName="SettingsNav"
                                 Style="{StaticResource SettingsNavItem}" Click="NavItem_Click" />
                    <RadioButton Content="自动化" Tag="2" GroupName="SettingsNav"
                                 Style="{StaticResource SettingsNavItem}" Click="NavItem_Click" />
                    <RadioButton Content="短信与通知" Tag="3" GroupName="SettingsNav"
                                 Style="{StaticResource SettingsNavItem}" Click="NavItem_Click" />
                    <RadioButton Content="关于" Tag="4" GroupName="SettingsNav"
                                 Style="{StaticResource SettingsNavItem}" Click="NavItem_Click" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <Grid Margin="26,16,26,24">
                    <StackPanel x:Name="Page0" Visibility="Visible">
                        <TextBlock Text="常规" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="启动行为与版本更新" FontSize="12" Opacity="0.65" Margin="0,4,0,20" />

                        <TextBlock Text="启动" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ui:Card Margin="0,0,0,20">
                            <Grid Margin="16,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="开机自启动" FontSize="14" />
                                    <TextBlock Text="登录 Windows 后在托盘中运行" FontSize="12" Opacity="0.62" Margin="0,3,0,0" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" x:Name="RunAtStartupSwitch" VerticalAlignment="Center" />
                            </Grid>
                        </ui:Card>

                        <TextBlock Text="版本" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ui:Card>
                            <Grid Margin="16,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="VersionText" Text="当前版本 —" FontSize="14" />
                                    <TextBlock Text="检查 GitHub 上的最新发布版本" FontSize="12" Opacity="0.62" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="CheckUpdatesButton" Content="检查更新" Padding="16,7" Click="CheckUpdatesButton_Click" />
                            </Grid>
                        </ui:Card>
                    </StackPanel>

                    <StackPanel x:Name="Page1" Visibility="Collapsed">
                        <TextBlock Text="ADB 与设备" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="指定 adb.exe 位置，以及多设备时的目标手机" FontSize="12" Opacity="0.65" Margin="0,4,0,20" />

                        <TextBlock Text="ADB 目录" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ui:Card Margin="0,0,0,20">
                            <StackPanel Margin="16,14">
                                <TextBlock Text="包含 adb.exe 的 platform-tools 目录。留空时从程序目录、Android SDK 和 PATH 自动查找。"
                                           FontSize="12" Opacity="0.62" TextWrapping="Wrap" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="AdbDirectoryBox" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="1" x:Name="BrowseButton" Content="浏览…" Padding="14,6" Margin="8,0,0,0" Click="BrowseButton_Click" />
                                </Grid>
                                <TextBlock x:Name="CurrentAdbText" Text="" FontSize="12" Opacity="0.62" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </ui:Card>

                        <TextBlock Text="目标设备" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ui:Card>
                            <StackPanel Margin="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="TargetDeviceBox" VerticalContentAlignment="Center" SelectionChanged="TargetDeviceBox_SelectionChanged" />
                                    <Button Grid.Column="1" x:Name="RefreshDevicesButton" Content="刷新列表" Padding="14,6" Margin="8,0,0,0" Click="RefreshDevicesButton_Click" />
                                </Grid>
                                <TextBlock x:Name="DeviceHintText" Text="" FontSize="12" Opacity="0.72" Margin="0,10,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>

                    <StackPanel x:Name="Page2" Visibility="Collapsed">
                        <TextBlock Text="自动化" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="USB 网络共享、掉线恢复与电脑热点" FontSize="12" Opacity="0.65" Margin="0,4,0,20" />

                        <TextBlock Text="USB 网络共享" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ui:Card Margin="0,0,0,20">
                            <StackPanel Margin="16,8">
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="启动后自动开启 USB 网络共享" FontSize="14" />
                                        <TextBlock Text="设备就绪后自动切换到 RNDIS" FontSize="12" Opacity="0.62" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" x:Name="AutoEnableUsbTetheringSwitch" VerticalAlignment="Center" Margin="16,0,0,0" />
                                </Grid>
                                <Rectangle Height="1" Fill="#14000000" Margin="-16,8" />
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="断开后自动重新开启" FontSize="14" />
                                        <TextBlock Text="连续确认 20 秒，失败冷却 60 秒；手动关闭后暂停" FontSize="12" Opacity="0.62" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" x:Name="AutoRecoverUsbTetheringSwitch" VerticalAlignment="Center" Margin="16,0,0,0" />
                                </Grid>
                                <Rectangle Height="1" Fill="#14000000" Margin="-16,8" />
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="启动后自动开启电脑热点" FontSize="14" />
                                        <TextBlock Text="把手机网络通过 Wi-Fi 转发给其他设备" FontSize="12" Opacity="0.62" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" x:Name="AutoStartPcHotspotSwitch" VerticalAlignment="Center" Margin="16,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>

                    <StackPanel x:Name="Page3" Visibility="Collapsed">
                        <TextBlock Text="短信与通知" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="程序启动之后收到的新短信，历史短信不读取" FontSize="12" Opacity="0.65" Margin="0,4,0,20" />

                        <TextBlock Text="同步" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ui:Card Margin="0,0,0,20">
                            <StackPanel Margin="16,8">
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="同步新短信（不读历史，默认关闭）" FontSize="14" />
                                        <TextBlock Text="正文默认隐藏，只在主动打开的列表里按需展开" FontSize="12" Opacity="0.62" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" x:Name="SmsSyncEnabledSwitch" VerticalAlignment="Center" Margin="16,0,0,0" />
                                </Grid>
                                <Rectangle Height="1" Fill="#14000000" Margin="-16,8" />
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="用 Windows 通知提醒" FontSize="14" />
                                        <TextBlock Text="系统不支持时自动回退到托盘气泡" FontSize="12" Opacity="0.62" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" x:Name="SmsToastEnabledSwitch" VerticalAlignment="Center" Margin="16,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <TextBlock Text="提醒过滤" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ui:Card>
                            <StackPanel Margin="16,14">
                                <TextBlock Text="只提醒这些发件人（留空为全部，逗号或空格分隔关键字；列表始终保留所有短信）"
                                           FontSize="12" Opacity="0.62" TextWrapping="Wrap" />
                                <TextBox x:Name="SmsSenderFilterBox" MaxLength="200" Margin="0,10,0,0" />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>

                    <StackPanel x:Name="Page4" Visibility="Collapsed">
                        <TextBlock Text="关于" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="ADB Device Vitals" FontSize="12" Opacity="0.65" Margin="0,4,0,20" />
                        <ui:Card>
                            <StackPanel Margin="16,14">
                                <TextBlock x:Name="AboutVersionText" Text="版本 —" FontSize="14" />
                                <TextBlock Text="通过本机 ADB 读取手机状态，不上传任何数据。" FontSize="12" Opacity="0.62" Margin="0,10,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="AboutConfigPathText" Text="" FontSize="12" Opacity="0.62" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="日志与 CSV 位于 %LOCALAPPDATA%\AdbDeviceVitals\logs" FontSize="12" Opacity="0.62" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#14000000">
            <Grid Margin="24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="ClearAdbButton" Content="恢复自动查找" Padding="14,7" Click="ClearAdbButton_Click" />
                <Button Grid.Column="2" x:Name="CancelButton" Content="取消" Padding="18,7" Margin="0,0,10,0" Click="CancelButton_Click" />
                <ui:Button Grid.Column="3" x:Name="SaveButton" Content="保存" Appearance="Primary" Padding="18,7" Click="SaveButton_Click" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
