<ui:FluentWindow x:Class="AdbDeviceVitals.SmsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="近期短信" Width="800" Height="540"
        MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        FontFamily="Segoe UI" FontSize="13"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="近期短信" />

        <Grid Grid.Row="1" Margin="20,6,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="4,0,4,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="仅本次运行期间的新短信 · 每 10 秒检查一次 · 不写入磁盘 · 默认隐藏正文"
                           FontSize="12" Opacity="0.65" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" x:Name="StatusText" Text="暂无新短信" FontSize="12"
                           Opacity="0.75" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>

            <ui:Card Grid.Row="1" Margin="0,0,0,10" Padding="0">
                <DataGrid x:Name="SmsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          VerticalScrollBarVisibility="Auto"
                          SelectionChanged="SmsGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="130" />
                        <DataGridTextColumn Header="发件人" Binding="{Binding Address}" Width="170" />
                        <DataGridTextColumn Header="内容" Binding="{Binding Preview}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </ui:Card>

            <ui:Card Grid.Row="2" Margin="0,0,0,10" Padding="0">
                <TextBox x:Name="DetailBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Height="106" BorderThickness="0"
                         Background="Transparent" Padding="12,8"
                         Text="选中上方任意一条短信，这里显示发件人与时间；正文默认隐藏。" />
            </ui:Card>

            <Grid Grid.Row="3">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="ToggleBodyButton" Content="显示正文" Appearance="Primary"
                               Padding="16,7" Margin="0,0,8,0" Click="ToggleBodyButton_Click" />
                    <Button x:Name="CopyCodeButton" Content="复制验证码" Padding="14,7" Margin="0,0,8,0"
                            IsEnabled="False" Click="CopyCodeButton_Click" />
                    <Button x:Name="CopyBodyButton" Content="复制正文" Padding="14,7" Margin="0,0,8,0"
                            IsEnabled="False" Click="CopyBodyButton_Click" />
                    <Button x:Name="ClearButton" Content="清空列表" Padding="14,7" Margin="0,0,8,0"
                            Click="ClearButton_Click" />
                    <Button x:Name="CloseButton" Content="关闭" Padding="14,7" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
