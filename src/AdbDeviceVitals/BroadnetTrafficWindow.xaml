<ui:FluentWindow x:Class="AdbDeviceVitals.BroadnetTrafficWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:AdbDeviceVitals.Controls"
        Title="广电套餐余量" Width="520" Height="790"
        MinWidth="440" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="广电套餐余量" />

        <ScrollViewer Grid.Row="1" Margin="20,6,20,8" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="SummaryText" FontSize="12" Opacity="0.62" TextWrapping="Wrap" Margin="4,0,18,10"
                           Text="点「刷新」从中国广电营业厅读取；首次使用会弹出窗口让你自己登录。" />

                <ui:Card Margin="0,0,0,8" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="账户"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="号码" FontSize="12" Opacity="0.62" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PhoneText" Text="—" FontSize="12" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="话费余额" FontSize="12" Opacity="0.62" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="BalanceText" Text="—" FontSize="12" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="当月消费" FontSize="12" Opacity="0.62" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SpendText" Text="—" FontSize="12" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="本月已用" FontSize="12" Opacity="0.62" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="UsedText" Text="—" FontSize="12" Margin="0,0,0,4" />
                    </Grid>
                </ui:Card>

                <ui:Card Margin="0,0,0,8" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="套餐余量" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ItemsControl x:Name="PackageList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0,1" BorderBrush="#22000000" Padding="0,6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{Binding Name, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="1" FontSize="11" Opacity="0.72" TextWrapping="Wrap" Margin="0,2,0,0">
                                                <Run Text="剩余 " /><Run Text="{Binding Remain, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Unit, Mode=OneWay}" />
                                                <Run Text="  / 共 " /><Run Text="{Binding Total, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Unit, Mode=OneWay}" />
                                                <Run Text="  · 已用 " /><Run Text="{Binding Used, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyText" Text="尚未读取数据，点下方「刷新」。" FontSize="12" Opacity="0.62"
                                   Margin="0,6,0,0" Visibility="Visible" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,0,8" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="用量统计" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="今日已用" FontSize="11" Opacity="0.62" />
                                <TextBlock x:Name="UsageTodayText" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="本月记录" FontSize="11" Opacity="0.62" />
                                <TextBlock x:Name="UsageMonthText" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="日均" FontSize="11" Opacity="0.62" />
                                <TextBlock x:Name="UsageAvgText" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                        <controls:UsageBarChart x:Name="UsageChart" Height="96" Margin="0,2,0,4" />
                        <TextBlock x:Name="UsageHintText" FontSize="11" Opacity="0.62" TextWrapping="Wrap"
                                   Text="每 10 分钟采样一次，按小时汇总。程序未运行或登录过期时不采样。" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,18">
            <ui:Button x:Name="RefreshButton" Content="刷新" Width="88" Margin="0,0,8,0" Click="Refresh_Click" />
            <Button Content="关闭" Width="78" Click="Close_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
