<ui:FluentWindow x:Class="AdbDeviceVitals.BroadnetTrafficWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:AdbDeviceVitals.Controls"
        Title="套餐余量" Width="520" Height="790"
        MinWidth="440" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="WindowTitle" Title="套餐余量" />

        <TabControl Grid.Row="1" x:Name="CarrierTabs" SelectedIndex="0" Margin="16,6,16,0" Background="Transparent" BorderThickness="0">
            <TabItem x:Name="BroadnetTab" Header="中国广电">
                <controls:TrafficCarrierPanel x:Name="BroadnetPanel" />
            </TabItem>
            <TabItem x:Name="TelecomTab" Header="中国电信">
                <controls:TrafficCarrierPanel x:Name="TelecomPanel" />
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,18">
            <ui:Button x:Name="RefreshButton" Content="刷新" Width="88" Margin="0,0,8,0" Click="Refresh_Click" />
            <Button Content="关闭" Width="78" Click="Close_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
