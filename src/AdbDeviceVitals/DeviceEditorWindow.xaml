<ui:FluentWindow x:Class="AdbDeviceVitals.DeviceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="设备" Width="480" Height="615"
        MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="WindowTitle" Title="添加设备" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,12">
            <TextBlock Text="设备" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock x:Name="DeviceStaticText" Text="" FontSize="13" Visibility="Collapsed"
                       Padding="10,8" Background="#0C000000" />
            <ComboBox x:Name="DeviceBox" VerticalContentAlignment="Center" />

            <TextBlock Text="流量运营商" FontSize="13" FontWeight="SemiBold" Margin="0,18,0,6" />
            <ComboBox x:Name="CarrierBox" VerticalContentAlignment="Center">
                <ComboBoxItem Content="自动探测（按卡槽 SIM）" Tag="0" />
                <ComboBoxItem Content="中国广电" Tag="1" />
                <ComboBoxItem Content="中国电信" Tag="2" />
            </ComboBox>

            <TextBlock Text="流量卡槽" FontSize="13" FontWeight="SemiBold" Margin="0,18,0,6" />
            <ComboBox x:Name="SlotBox" VerticalContentAlignment="Center">
                <ComboBoxItem Content="自动探测" Tag="-1" />
                <ComboBoxItem Content="卡槽 0" Tag="0" />
                <ComboBoxItem Content="卡槽 1" Tag="1" />
            </ComboBox>

            <TextBlock Text="优先级（数字越小越优先，用于掉线自动切换）" FontSize="13" FontWeight="SemiBold"
                       Margin="0,18,0,6" TextWrapping="Wrap" />
            <TextBox x:Name="PriorityBox" VerticalContentAlignment="Center" Width="90" HorizontalAlignment="Left" Text="1" />

            <ui:ToggleSwitch x:Name="MeteredUsbSwitch" Margin="0,18,0,4"
                             Content="USB 共享时启用按流量计费的连接" />
            <TextBlock FontSize="12" Opacity="0.72" TextWrapping="Wrap"
                       Text="关闭后由你在 Windows 中管理这台手机的计费设置。" />
            <ui:ToggleSwitch x:Name="AutoScreenOffSwitch" Margin="0,16,0,4" Content="自动息屏" />
            <TextBlock FontSize="12" Opacity="0.72" TextWrapping="Wrap"
                       Text="ADB 连接期间，手机亮屏且连续 5 分钟无操作时自动息屏。" />
            <TextBlock x:Name="ProbeText" Text="" FontSize="12" Opacity="0.62" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,8,20,16">
            <Button x:Name="ProbeButton" Content="重新探测" Padding="12,6" Margin="0,0,8,0" Click="ProbeButton_Click" />
            <Button x:Name="RemoveButton" Content="移除设备" Padding="12,6" Margin="0,0,8,0"
                    Visibility="Collapsed" Click="RemoveButton_Click" />
            <Button x:Name="CancelButton" Content="取消" Padding="16,6" Margin="0,0,8,0" Click="CancelButton_Click" />
            <ui:Button x:Name="OkButton" Content="保存" Appearance="Primary" Padding="16,6" Click="OkButton_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
