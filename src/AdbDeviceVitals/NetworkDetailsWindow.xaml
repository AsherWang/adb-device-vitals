<ui:FluentWindow x:Class="AdbDeviceVitals.NetworkDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="网络详情" Width="520" Height="720"
        MinWidth="460" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.62" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="网络详情" />

        <ScrollViewer Grid.Row="1" Margin="20,6,20,8" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="4,0,18,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="11" Opacity="0.62" TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="原始参数 · 评级取 RSRP 与 SINR 较差一档，只描述手机到基站" />
                    <TextBlock Grid.Column="1" x:Name="SampleTimeText" Text="—" FontSize="11" Opacity="0.62"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </Grid>

                <ui:Card Margin="0,0,0,8" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="信号判据" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock FontSize="11" Opacity="0.78" Margin="0,0,0,4"
                                   Text="RSRP(dBm)：≥ −80 极好 ｜ −80~−90 好 ｜ −90~−105 一般 ｜ &lt; −105 差" />
                        <TextBlock FontSize="11" Opacity="0.78"
                                   Text="SINR(dB)：≥ 20 极好 ｜ 13~20 好 ｜ 5~13 一般 ｜ &lt; 5 差" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,0,8" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="蜂窝链路"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="网络类型" Style="{StaticResource LabelText}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="NetworkTypeText" Text="—" Style="{StaticResource ValueText}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="运营商" Style="{StaticResource LabelText}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="OperatorText" Text="—" Style="{StaticResource ValueText}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="RSRP" Style="{StaticResource LabelText}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="RsrpText" Text="—" Style="{StaticResource ValueText}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="RSRQ" Style="{StaticResource LabelText}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="RsrqText" Text="—" Style="{StaticResource ValueText}" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="SINR" Style="{StaticResource LabelText}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="SinrText" Text="—" Style="{StaticResource ValueText}" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="系统信号等级" Style="{StaticResource LabelText}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="SignalLevelText" Text="—" Style="{StaticResource ValueText}" />
                    </Grid>
                </ui:Card>

                <!-- 手机侧共享明细原来挂在「网速」卡片的 ToolTip 上，现在由该卡片的 ⓘ 打开这里。 -->
                <ui:Card x:Name="TetheringCard" Margin="0,0,0,8" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="设备与网络共享"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="型号" Style="{StaticResource LabelText}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ModelText" Text="—" Style="{StaticResource ValueText}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="序列号" Style="{StaticResource LabelText}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SerialText" Text="—" Style="{StaticResource ValueText}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="上游接口" Style="{StaticResource LabelText}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="UpstreamText" Text="—" Style="{StaticResource ValueText}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="共享方式" Style="{StaticResource LabelText}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TetherModeText" Text="—" Style="{StaticResource ValueText}" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="连接明细" Style="{StaticResource LabelText}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TetherDetailText" Text="—" Style="{StaticResource ValueText}" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" FontSize="11" Opacity="0.62"
                                   Margin="0,2,0,0" TextWrapping="Wrap"
                                   Text="电脑侧热点开关在主窗口下方「电脑热点」一行" />
                    </Grid>
                </ui:Card>

                <ui:Card Margin="0,0,0,8" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="电脑出口网络"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="IPv4" Style="{StaticResource LabelText}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="Ipv4Text" Text="—" Style="{StaticResource ValueText}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="IPv6" Style="{StaticResource LabelText}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="Ipv6Text" Text="—" Style="{StaticResource ValueText}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="出口查询时间" Style="{StaticResource LabelText}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="IpTimeText" Text="—" Style="{StaticResource ValueText}" />
                    </Grid>
                </ui:Card>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,18">
            <Button Content="复制出口 IP" Width="112" Margin="0,0,8,0" Click="CopyIp_Click" />
            <Button Content="关闭" Width="78" Click="Close_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
