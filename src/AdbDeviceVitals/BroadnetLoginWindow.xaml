<ui:FluentWindow x:Class="AdbDeviceVitals.BroadnetLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="中国广电 · 网上营业厅登录" Width="1080" Height="760"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="中国广电 · 网上营业厅登录" />

        <Grid Grid.Row="1" Margin="20,4,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusText" FontSize="12" Opacity="0.72"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="正在打开登录页…"
                       ToolTip="账号、验证码、滑块全部由你手动完成；程序只检测登录结果，不读取也不保存密码。" />
            <TextBlock Grid.Column="1" x:Name="PhoneText" FontSize="12" Opacity="0.72"
                       VerticalAlignment="Center" Margin="14,0,0,0" Text="" />
        </Grid>

        <Border Grid.Row="2" Margin="20,0,20,6" BorderThickness="1" CornerRadius="6"
                BorderBrush="#22000000" Background="#FFFFFF" ClipToBounds="True">
            <wv2:WebView2 x:Name="Browser" DefaultBackgroundColor="#FFFFFF" />
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,4,20,16">
            <TextBlock FontSize="11" Opacity="0.62" VerticalAlignment="Center" Margin="0,0,14,0"
                       Text="登录成功后窗口会自动关闭" />
            <Button x:Name="ConfirmButton" Content="我已登录" Padding="14,7" Margin="0,0,8,0"
                    Click="ConfirmButton_Click" ToolTip="登录完成后点这里，或等待程序自动检测" />
            <Button Content="关闭" Padding="14,7" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
