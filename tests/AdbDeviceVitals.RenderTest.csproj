<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Console subsystem: PowerShell waits for it and sees the real exit code. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>RenderSmokeTest</AssemblyName>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="RenderSmokeTest.cs" />
    <ProjectReference Include="..\src\AdbDeviceVitals\AdbDeviceVitals.csproj" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>
</Project>
